# Plantilla de .env (solo nombres; copiar a .env, que no se versiona, y completar los valores)
# En local lo lee spring.config.import; en Docker se pasa con --env-file desde dockerdeploy.ps1

# Contraseñas SQL Server del usuario Back (spring.datasource / spring.second-datasource)
MDSERP_DB_PASSWORD=
PDM_DB_PASSWORD=

# Webhook entrante de Bitrix24 (bitrix.webhook-url)
BITRIX_WEBHOOK_URL=

# Conector BI Builder de Bitrix24
B24_APP_PUBLIC_BASE_URL=https://erp.proelectricos.com/api
# Clave compartida aleatoria (>= 32 bytes) que Bitrix24 envia en connection[key]
B24_CONNECTOR_KEY=
B24_CONNECTOR_DEFAULT_WINDOW_DAYS=90
# App local de Bitrix24 (registro del conector; callback en {B24_APP_PUBLIC_BASE_URL}/bitrix-app/install)
B24_PORTAL_URL=https://proelectricos.bitrix24.es
B24_APP_CLIENT_ID=

# Chatbot (ver application.properties)
CHATBOT_ENABLED=false
GEMINI_API_KEY=
GEMINI_MODEL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_CHAT_IDS=
CHATBOT_DB_USER=
CHATBOT_DB_PASSWORD=
TTS_MODO=
TTS_MODELO=
TTS_VOZ=
