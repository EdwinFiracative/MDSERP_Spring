2026-10-07T12:24:46.999-05:00  INFO 27824 --- [MDSERP] [pool-4-thread-3] c.p.m.chatbot.service.ErpDbChatTools     : Chatbot -> consultar_sql {consulta=SELECT TOP 10 
    oh.orderHeaderNumber AS Pedido,
    oh.orderHeaderDate AS Fecha,
    tp_cliente.thirdPartyName AS Cliente,
    SUM(or_ref.orderReferQuantity * or_ref.orderReferUnitPrice) AS Total
FROM OrderHeader oh
JOIN Vendor v ON oh.orderHeaderVendor = v.vendorId
JOIN ThirdParty tp_vend ON v.vendorThirdParty = tp_vend.thirdPartyId
JOIN Branch b ON oh.orderHeaderBranch = b.branchId
JOIN Client c ON b.branchClient = c.clientId
JOIN ThirdParty tp_cliente ON c.clientThirdParty = tp_cliente.thirdPartyId
JOIN OrderReference or_ref ON oh.orderHeaderId = or_ref.orderReferOrderHeader
WHERE tp_vend.thirdPartyName LIKE '%BEDOYA CONTRERAS JHON HEYDER%'
GROUP BY oh.orderHeaderNumber, oh.orderHeaderDate, tp_cliente.thirdPartyName
ORDER BY oh.orderHeaderDate DESC;}
